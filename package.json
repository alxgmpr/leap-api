{
  "name": "leap-openapi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "gen:schemas": "npx tsx tools/gen-schemas.ts",
    "gen:paths": "npx tsx tools/gen-paths.ts",
    "redact": "npx tsx tools/redact.ts",
    "bundle": "npx tsx tools/bundle.ts",
    "coverage": "npx tsx tools/check-coverage.ts",
    "census": "npx tsx tools/derive-census.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:spec": "redocly lint dist/openapi.yaml",
    "render": "npx @scalar/cli document serve dist/openapi.yaml",
    "build:site": "redocly build-docs dist/openapi.yaml --output site/index.html",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": { "yaml": "^2.8.2" },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@redocly/cli": "^1.25.0",
    "@types/node": "^24.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
